---
// Snowfall.astro - 60 FPS Canvas Snowfall Particle Engine
---
<canvas id="snowCanvas" class="fixed inset-0 pointer-events-none z-10 w-full h-full" aria-hidden="true"></canvas>

<script>
  (function () {
    const canvas = document.getElementById("snowCanvas") as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let flakes: Flake[] = [];
    let raf: number | null = null;
    let last = 0;
    let snowActive = true;

    interface Flake {
      x: number;
      y: number;
      r: number;
      vy: number;
      vx: number;
      sway: number;
      swaySpeed: number;
      alpha: number;
      kind: number;
      sprite: HTMLCanvasElement;
    }

    function glowSprite(): HTMLCanvasElement {
      const s = document.createElement("canvas");
      s.width = 32;
      s.height = 32;
      const c = s.getContext("2d")!;
      const g = c.createRadialGradient(16, 16, 0, 16, 16, 16);
      g.addColorStop(0, "rgba(255,255,255,1)");
      g.addColorStop(0.3, "rgba(224,242,254,0.85)");
      g.addColorStop(0.7, "rgba(56,189,248,0.25)");
      g.addColorStop(1, "rgba(56,189,248,0)");
      c.fillStyle = g;
      c.beginPath();
      c.arc(16, 16, 16, 0, Math.PI * 2);
      c.fill();
      return s;
    }

    function starSprite(): HTMLCanvasElement {
      const s = document.createElement("canvas");
      s.width = 24;
      s.height = 24;
      const c = s.getContext("2d")!;
      c.translate(12, 12);
      c.strokeStyle = "rgba(255,255,255,0.9)";
      c.lineWidth = 1.4;
      c.lineCap = "round";
      for (let i = 0; i < 6; i++) {
        c.beginPath();
        c.moveTo(0, 0);
        c.lineTo(0, 9);
        c.stroke();
        c.beginPath();
        c.moveTo(0, 5);
        c.lineTo(3, 7);
        c.stroke();
        c.beginPath();
        c.moveTo(0, 5);
        c.lineTo(-3, 7);
        c.stroke();
        c.rotate(Math.PI / 3);
      }
      return s;
    }

    const spriteGlow = glowSprite();
    const spriteStar = starSprite();

    function makeFlake(fromTop = false): Flake {
      const kind = Math.random();
      const depth = Math.random();
      const r = 1.2 + depth * 3.8;
      const vy = 25 + depth * 55;
      const vx = (Math.random() - 0.5) * 12;
      const sway = Math.random() * Math.PI * 2;
      const swaySpeed = 0.6 + Math.random() * 1.2;
      const alpha = 0.35 + depth * 0.55;
      return {
        x: Math.random() * width,
        y: fromTop ? -10 - Math.random() * 20 : Math.random() * height,
        r,
        vy,
        vx,
        sway,
        swaySpeed,
        alpha,
        kind,
        sprite: kind > 0.88 ? spriteStar : spriteGlow,
      };
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = width + "px";
      canvas.style.height = height + "px";
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function populate() {
      const target = Math.min(Math.floor((width * height) / 14000), 100);
      flakes = [];
      for (let i = 0; i < target; i++) {
        flakes.push(makeFlake(false));
      }
    }

    function frame(now: number) {
      if (!last) last = now;
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;

      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < flakes.length; i++) {
        const f = flakes[i];
        f.sway += f.swaySpeed * dt;
        const wind = Math.sin(f.sway) * 18;
        f.y += f.vy * dt;
        f.x += (f.vx + wind) * dt;

        if (f.y > height + 20) {
          flakes[i] = makeFlake(true);
          continue;
        }
        if (f.x < -20) f.x = width + 10;
        else if (f.x > width + 20) f.x = -10;

        ctx.globalAlpha = f.alpha;
        const size = f.r * 2.4;
        ctx.drawImage(f.sprite, f.x - size / 2, f.y - size / 2, size, size);
      }
      ctx.globalAlpha = 1;

      if (snowActive) {
        raf = requestAnimationFrame(frame);
      }
    }

    function start() {
      if (!raf && snowActive) {
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }
    }

    function stop() {
      if (raf) {
        cancelAnimationFrame(raf);
        raf = null;
      }
    }

    window.addEventListener("resize", () => {
      resize();
      populate();
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    resize();
    populate();
    start();
  })();
</script>
