---
// Header.astro - Identical Announcement Bar & Frosted-Glass Navigation
---
<!-- ANNOUNCEMENT BAR: Real-time ski piste opening status, altitude, direct phone/WhatsApp links, snow toggle & language switcher -->
<div class="top-bar">
  <div class="top-bar-inner">
    <div class="status-badge">
      <span class="pulse-dot"></span>
      <span data-i18n="top_status">Пониква • 1,560m • Отворена Ски Патека 08:30 – 17:00</span>
    </div>
    <div class="top-links">
      <a href="tel:+38970000000" id="top-phone">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path
            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        +389 70 000 000
      </a>
      <a href="https://wa.me/38970000000" target="_blank" rel="noopener" id="top-wa">
        <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.45 0-2.88-.38-4.13-1.11l-.3-.17-3.12.82.83-3.04-.2-.31a8.21 8.21 0 0 1-1.26-4.43c0-4.54 3.69-8.25 8.24-8.25m4.52 11.66c-.25.7-.72 1.29-1.39 1.57-.45.19-.94.27-1.46.25-2.07-.1-4.2-1.74-5.69-3.23-1.49-1.49-3.13-3.62-3.23-5.69-.02-.52.06-1.01.25-1.46.28-.67.87-1.14 1.57-1.39.29-.11.63-.09.89.06.31.18.73 1.05.9 1.44.11.26.06.58-.13.77l-.46.46c-.16.16-.18.41-.05.6.45.69 1.09 1.44 1.83 2.18.74.74 1.49 1.38 2.18 1.83.19.13.44.11.6-.05l.46-.46c.19-.19.51-.24.77-.13.39.17 1.26.59 1.44.9.15.26.17.6.06.89" />
        </svg>
        WhatsApp
      </a>
      <button class="snow-toggle-btn" id="toggleSnow" title="Toggle Snowfall">
        <span>❄️</span> <span id="snowStatusText">Snow ON</span>
      </button>
      <!-- Language Switch -->
      <div class="lang-toggle">
        <button class="lang-btn active" id="btn-mk">MK</button>
        <button class="lang-btn" id="btn-en">EN</button>
      </div>
    </div>
  </div>
</div>

<!-- MAIN NAVIGATION HEADER: Sticky frosted-glass navbar with brand logo, section anchors, booking CTA, and mobile hamburger drawer -->
<header class="site-nav" id="navbar">
  <div class="nav-container">
    <!-- Brand Logo Component -->
    <a href="#" class="brand">
      <div class="brand-mark">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="m8 3 4 8 5-5 5 15H2L8 3z" />
          <path d="M4 14l4-3 4 5" />
        </svg>
      </div>
      <div class="brand-text">
        <h1>СКИ НАДЈА</h1>
        <span data-i18n="brand_sub">ПОНИКВА • ОСОГОВО</span>
      </div>
    </a>

    <!-- Primary Navigation Links -->
    <nav>
      <ul class="nav-menu" id="navMenu">
        <li><a href="#equipment" data-i18n="nav_equipment">Опрема</a></li>
        <li><a href="#advantages" data-i18n="nav_why">Зошто нас</a></li>
        <li><a href="#pricing" data-i18n="nav_pricing">Ценовник</a></li>
        <li><a href="#villa" data-i18n="nav_villa">Планинска Вила</a></li>
        <li><a href="#location" data-i18n="nav_location">Локација</a></li>
        <li><a href="#contact" data-i18n="nav_contact">Контакт</a></li>
      </ul>
    </nav>

    <!-- Header Action & Mobile Menu Toggle -->
    <div class="nav-cta">
      <a href="#contact" class="btn-nav">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
        <span data-i18n="nav_book_btn">Резервирај</span>
      </a>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle Navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile Navigation Drawer Toggle
  const menuToggle = document.getElementById("menuToggle");
  const navMenu = document.getElementById("navMenu");
  if (menuToggle && navMenu) {
    menuToggle.addEventListener("click", () => {
      navMenu.classList.toggle("mobile-open");
    });
    navMenu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        navMenu.classList.remove("mobile-open");
      });
    });
  }

  // Sticky Navbar Scroll Listener
  window.addEventListener("scroll", () => {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;
    if (window.scrollY > 30) {
      navbar.classList.add("scrolled");
    } else {
      navbar.classList.remove("scrolled");
    }
  }, { passive: true });
</script>
