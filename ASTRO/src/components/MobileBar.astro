  <a href="https://wa.me/38970000000" target="_blank" rel="noopener" id="mob-wa" class="flex-1 flex flex-col items-center justify-center py-1.5 px-2 rounded-xl bg-emerald-50 active:bg-emerald-100 text-emerald-800 text-xs font-bold transition-colors">
