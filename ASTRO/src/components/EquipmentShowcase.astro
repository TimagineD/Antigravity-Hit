---
// EquipmentShowcase.astro - Interactive Gear Visuals & Spec Rows
---
<section class="py-24 sm:py-32 relative z-20" id="equipment">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Badge -->
    <div class="text-center max-w-3xl mx-auto mb-20 sm:mb-24">
      <span class="inline-block px-4 py-1.5 rounded-full bg-sky-100 text-sky-700 text-xs sm:text-sm font-bold tracking-wider uppercase mb-3" data-i18n="sec_eyebrow">
        Нашата Опрема
      </span>
      <h2 class="font-display font-black text-3xl sm:text-5xl text-slate-900 tracking-tight" data-i18n="sec_main_title">
        Подготвени за Секој Снежен Спуст
      </h2>
    </div>

    <!-- Product Rows Container -->
    <div class="space-y-24 sm:space-y-36">

      <!-- 1. SKI EQUIPMENT ROW -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left: Image as Clean Overlay with Badges -->
        <div class="lg:col-span-7 relative group">
          <div class="relative">
            <picture>
              <source srcset="/images/section1-skier.webp" type="image/webp" />
              <img src="/images/section1-skier.png" alt="Скијач на Пониква - Ски Надја" width="1107" height="749" class="w-full h-auto object-contain transform group-hover:scale-[1.02] transition-transform duration-500" loading="lazy" />
            </picture>
          </div>

          <!-- Floating Badges -->
          <div class="absolute -top-3 -left-3 sm:top-4 sm:left-4 bg-slate-900/80 backdrop-blur-md border border-white/20 text-white text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-2 animate-float">
            <span>⛷️</span>
            <span data-i18n="ski_badge_1">Atomic & Head Carving</span>
          </div>
          <div class="absolute -bottom-3 -right-3 sm:bottom-4 sm:right-4 bg-white/90 backdrop-blur-md border border-slate-200 text-slate-900 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-2">
            <span>🛡️</span>
            <span data-i18n="ski_badge_2">Комплет со шлем и стапчиња</span>
          </div>
        </div>

        <!-- Right: Content & Specs -->
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-sky-100 text-sky-800 font-bold text-xs uppercase" data-i18n="ski_tag">
            Ски Комплети
          </div>
          <h3 class="font-display font-black text-2xl sm:text-4xl text-slate-900 leading-tight" data-i18n="ski_title">
            Професионална Ски Опрема
          </h3>
          <p class="text-slate-600 text-base sm:text-lg leading-relaxed" data-i18n="ski_desc">
            Скии, стапчиња, удобни панцири, ракавици и заштитни одела — прецизно нагодени на вашата висина, тежина и скијачко ниво. Ве чекаат подготвени на стартот на патеката!
          </p>

          <!-- Spec Pills -->
          <div class="flex flex-wrap gap-2.5 pt-2">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🎿</span> <span data-i18n="ski_spec_1">Carving & All-Mountain</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>👢</span> <span data-i18n="ski_spec_2">Броеви: 25 – 48</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🪖</span> <span data-i18n="ski_spec_3">Заштитни Шлемови</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>✨</span> <span data-i18n="ski_spec_4">Свежо Восочени Скии</span>
            </span>
          </div>

          <!-- Buttons -->
          <div class="flex items-center gap-4 pt-4">
            <a href="#contact" class="select-gear-btn inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-sm sm:text-base px-6 py-3.5 rounded-2xl shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 transition-all duration-300 hover:-translate-y-0.5" data-gear="Ski equipment">
              <span data-i18n="btn_rent_ski">Резервирај Ски Комплет</span>
            </a>
            <a href="tel:+38970000000" class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-sm sm:text-base px-5 py-3.5 rounded-2xl border border-slate-200 transition-all duration-200">
              <span>📞</span>
              <span data-i18n="btn_call_us">Јави се</span>
            </a>
          </div>
        </div>

      </div>

      <!-- 2. SNOWBOARD EQUIPMENT ROW (REVERSED) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left: Content & Specs (on desktop) -->
        <div class="lg:col-span-5 space-y-6 order-2 lg:order-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-cyan-100 text-cyan-800 font-bold text-xs uppercase" data-i18n="board_tag">
            Сноуборд Забава
          </div>
          <h3 class="font-display font-black text-2xl sm:text-4xl text-slate-900 leading-tight" data-i18n="board_title">
            Сноуборд за Чист Адреналин
          </h3>
          <p class="text-slate-600 text-base sm:text-lg leading-relaxed" data-i18n="board_desc">
            Врвни даски за сноуборд, квалитетни меки чизми со брзо стегање, заштитни шлемови и очила. Од вашите први свиоци до брзи карвинг спустови на свеж снег!
          </p>

          <!-- Spec Pills -->
          <div class="flex flex-wrap gap-2.5 pt-2">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🏂</span> <span data-i18n="board_spec_1">Freeride & All-Mountain</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🥾</span> <span data-i18n="board_spec_2">Броеви: 35 – 47</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🔄</span> <span data-i18n="board_spec_3">Регулирање на аглите (Stance)</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🧤</span> <span data-i18n="board_spec_4">Топли Ракавици & Заштита</span>
            </span>
          </div>

          <!-- Buttons -->
          <div class="flex items-center gap-4 pt-4">
            <a href="#contact" class="select-gear-btn inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-sm sm:text-base px-6 py-3.5 rounded-2xl shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 transition-all duration-300 hover:-translate-y-0.5" data-gear="Snowboard equipment">
              <span data-i18n="btn_rent_board">Резервирај Сноуборд</span>
            </a>
            <a href="https://wa.me/38970000000" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-sm sm:text-base px-5 py-3.5 rounded-2xl border border-emerald-200 transition-all duration-200">
              <span>💬</span>
              <span>WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Right: Image as Clean Overlay with Badges -->
        <div class="lg:col-span-7 relative group order-1 lg:order-2">
          <div class="relative">
            <picture>
              <source srcset="/images/section2-snowboarder.webp" type="image/webp" />
              <img src="/images/section2-snowboarder.png" alt="Сноубордер на Пониква - Ски Надја" width="1247" height="919" class="w-full h-auto object-contain transform group-hover:scale-[1.02] transition-transform duration-500" loading="lazy" />
            </picture>
          </div>

          <!-- Floating Badges -->
          <div class="absolute -top-3 -right-3 sm:top-4 sm:right-4 bg-slate-900/80 backdrop-blur-md border border-white/20 text-white text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-2 animate-float">
            <span>🏂</span>
            <span data-i18n="board_badge_1">Nitro & Burton Boards</span>
          </div>
          <div class="absolute -bottom-3 -left-3 sm:bottom-4 sm:left-4 bg-white/90 backdrop-blur-md border border-slate-200 text-slate-900 text-xs sm:text-sm font-semibold px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-2">
            <span>❄️</span>
            <span data-i18n="board_badge_2">За почетници и напредни</span>
          </div>
        </div>

      </div>

      <!-- 3. KIDS & FAMILY SLEDGES ROW -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left: Image as Clean Overlay -->
        <div class="lg:col-span-7 relative group">
          <div class="relative">
            <picture>
              <source srcset="/images/section3-kids.webp" type="image/webp" />
              <img src="/images/section3-kids.png" alt="Детски санки и опрема на Пониква - Ски Надја" width="1408" height="785" class="w-full h-auto object-contain transform group-hover:scale-[1.02] transition-transform duration-500" loading="lazy" />
            </picture>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-amber-100 text-amber-800 font-bold text-xs uppercase" data-i18n="kids_tag">
            За Семејства & Најмладите
          </div>
          <h3 class="font-display font-black text-2xl sm:text-4xl text-slate-900 leading-tight" data-i18n="kids_title">
            За Најмладите и Најхрабрите
          </h3>
          <p class="text-slate-600 text-base sm:text-lg leading-relaxed" data-i18n="kids_desc">
            Санки за еден или двајца, детска ски опрема во минијатурни големини и топла заштитна облека за сигурна и насмеана семејна забава на снегот.
          </p>

          <!-- Spec Pills -->
          <div class="flex flex-wrap gap-2.5 pt-2">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🛷</span> <span data-i18n="kids_spec_1">Единечни и Двојни Санки</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🎿</span> <span data-i18n="kids_spec_2">Детски Скии (од 70 cm)</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>🧥</span> <span data-i18n="kids_spec_3">Топли Скафандери (2 – 14 год.)</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-100 border border-slate-200/80 text-xs sm:text-sm font-medium text-slate-700">
              <span>⛑️</span> <span data-i18n="kids_spec_4">Детски Шлемови со Сертификат</span>
            </span>
          </div>

          <!-- Buttons -->
          <div class="pt-4">
            <a href="#contact" class="select-gear-btn inline-flex items-center gap-2 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold text-sm sm:text-base px-6 py-3.5 rounded-2xl shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 transition-all duration-300 hover:-translate-y-0.5" data-gear="Sledges and kids' gear">
              <span data-i18n="btn_rent_kids">Резервирај Детска Опрема / Санки</span>
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
