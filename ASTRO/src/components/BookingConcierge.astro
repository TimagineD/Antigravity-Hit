---
// BookingConcierge.astro - Fast Direct Channels & Interactive WhatsApp Form Generator
---
<section class="py-24 sm:py-32 relative z-20" id="contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl sm:rounded-[36px] shadow-2xl border border-slate-200/80 p-6 sm:p-12 lg:p-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

        <!-- Left Column: Fast Contacts & Info -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <h2 class="font-display font-black text-3xl sm:text-4xl text-slate-900 tracking-tight mb-3" data-i18n="book_box_title">
              Резервирајте Ја Вашата Опрема
            </h2>
            <p class="text-slate-600 text-base leading-relaxed" data-i18n="book_box_desc">
              Изберете ја потребната опрема, внесете ги вашите информации и испратете директна порака на WhatsApp или Viber за инстант потврда на вашите големини.
            </p>
          </div>

          <!-- Direct Channels Buttons -->
          <div class="space-y-3.5">
            <a href="tel:+38970000000" id="call-main" class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-200 transition-all duration-200 group">
              <div class="flex items-center gap-3">
                <span class="text-2xl">📞</span>
                <span class="font-bold text-slate-800 text-sm sm:text-base" data-i18n="btn_direct_call">Јавете се Веднаш</span>
              </div>
              <strong class="text-sky-600 font-bold text-sm sm:text-base group-hover:translate-x-1 transition-transform">+389 70 000 000</strong>
            </a>

            <a href="https://wa.me/38970000000" target="_blank" rel="noopener" id="wa-main" class="flex items-center justify-between p-4 rounded-2xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-all duration-200 group">
              <div class="flex items-center gap-3">
                <span class="text-2xl">💬</span>
                <span class="font-bold text-emerald-950 text-sm sm:text-base" data-i18n="btn_direct_wa">Пишете ни на WhatsApp</span>
              </div>
              <strong class="text-emerald-600 font-bold text-sm sm:text-base group-hover:translate-x-1 transition-transform">WhatsApp Chat →</strong>
            </a>

            <a href="viber://chat?number=%2B38970000000" id="viber-main" class="flex items-center justify-between p-4 rounded-2xl bg-purple-50 hover:bg-purple-100 border border-purple-200 transition-all duration-200 group">
              <div class="flex items-center gap-3">
                <span class="text-2xl">🟣</span>
                <span class="font-bold text-purple-950 text-sm sm:text-base" data-i18n="btn_direct_viber">Пишете ни на Viber</span>
              </div>
              <strong class="text-purple-600 font-bold text-sm sm:text-base group-hover:translate-x-1 transition-transform">Viber Chat →</strong>
            </a>
          </div>

          <!-- Mini Location Box -->
          <div class="p-5 rounded-2xl bg-sky-50 border border-sky-100 text-xs sm:text-sm text-sky-900 space-y-1.5">
            <strong class="block font-bold text-sky-950" data-i18n="loc_mini_t">📍 Локација на ски ренталот:</strong>
            <p class="leading-relaxed text-sky-800" data-i18n="loc_mini_d">
              Пониква, Осоговски Планини (веднаш на почетокот на скијачката патека). Работиме секој ден од 08:30 до 17:00 часот.
            </p>
          </div>
        </div>

        <!-- Right Column: Interactive WhatsApp Form -->
        <div class="lg:col-span-7 bg-slate-50/70 p-6 sm:p-8 rounded-3xl border border-slate-200">
          <form id="inquiryForm" class="space-y-6">
            
            <!-- User Name -->
            <div>
              <label for="userName" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2" data-i18n="form_name">
                Вашето Име и Презиме
              </label>
              <input 
                type="text" 
                id="userName" 
                name="name" 
                class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500 font-medium text-slate-800 text-sm" 
                placeholder="пр. Марко Петровски" 
                required 
                autocomplete="name"
              />
            </div>

            <!-- Category Radio Pills -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2" data-i18n="form_category">
                Што ви е потребно?
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                <label class="cursor-pointer">
                  <input type="radio" name="topic" value="Ski equipment" class="peer sr-only" checked />
                  <div class="p-3 rounded-xl bg-white border border-slate-200 text-center peer-checked:border-sky-500 peer-checked:bg-sky-50 peer-checked:text-sky-700 text-xs font-bold transition-all shadow-sm">
                    <span class="block text-xl mb-1">🎿</span>
                    <span data-i18n="opt_ski">Ски Комплет</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="topic" value="Snowboard equipment" class="peer sr-only" />
                  <div class="p-3 rounded-xl bg-white border border-slate-200 text-center peer-checked:border-sky-500 peer-checked:bg-sky-50 peer-checked:text-sky-700 text-xs font-bold transition-all shadow-sm">
                    <span class="block text-xl mb-1">🏂</span>
                    <span data-i18n="opt_board">Сноуборд</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="topic" value="Sledges and kids' gear" class="peer sr-only" />
                  <div class="p-3 rounded-xl bg-white border border-slate-200 text-center peer-checked:border-sky-500 peer-checked:bg-sky-50 peer-checked:text-sky-700 text-xs font-bold transition-all shadow-sm">
                    <span class="block text-xl mb-1">🛷</span>
                    <span data-i18n="opt_kids">Санки / Деца</span>
                  </div>
                </label>

                <label class="cursor-pointer">
                  <input type="radio" name="topic" value="Mountain villa" class="peer sr-only" />
                  <div class="p-3 rounded-xl bg-white border border-slate-200 text-center peer-checked:border-sky-500 peer-checked:bg-sky-50 peer-checked:text-sky-700 text-xs font-bold transition-all shadow-sm">
                    <span class="block text-xl mb-1">🏡</span>
                    <span data-i18n="opt_villa">Планинска Вила</span>
                  </div>
                </label>
              </div>
            </div>

            <!-- Date & People Counter Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="bookDate" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2" data-i18n="form_date">
                  Датум на пристигнување
                </label>
                <input 
                  type="date" 
                  id="bookDate" 
                  class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500 font-medium text-slate-800 text-sm"
                />
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2" data-i18n="form_people">
                  Број на лица
                </label>
                <div class="flex items-center justify-between px-4 py-2 rounded-xl bg-white border border-slate-200">
                  <button type="button" id="btnMinus" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold flex items-center justify-center transition-colors cursor-pointer">-</button>
                  <span id="peopleCount" class="font-display font-black text-lg text-slate-900">2</span>
                  <button type="button" id="btnPlus" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold flex items-center justify-center transition-colors cursor-pointer">+</button>
                </div>
              </div>
            </div>

            <!-- Details Textarea -->
            <div>
              <label for="userMsg" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2" data-i18n="form_details">
                Големини / Чизми / Детали
              </label>
              <textarea 
                id="userMsg" 
                rows="3" 
                class="w-full px-4 py-3 rounded-xl bg-white border border-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500 font-medium text-slate-800 text-sm resize-none" 
                placeholder="пр. Број на чевли 42 и 38, висина 180cm, за 2 дена"
              ></textarea>
            </div>

            <!-- Live WhatsApp Message Preview -->
            <div class="p-4 rounded-2xl bg-emerald-50/70 border border-emerald-200/80">
              <strong class="block text-xs font-bold text-emerald-900 mb-2" data-i18n="msg_preview_title">
                📋 Преглед на пораката за WhatsApp:
              </strong>
              <div id="liveMsgPreview" class="text-xs sm:text-sm font-mono text-emerald-800 whitespace-pre-line bg-white/90 p-3 rounded-xl border border-emerald-100">
                ...
              </div>
            </div>

            <!-- Submit WhatsApp Button -->
            <button 
              type="submit" 
              class="w-full inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-700 hover:to-teal-600 text-white font-bold py-4 rounded-2xl shadow-xl shadow-emerald-600/30 hover:shadow-emerald-600/40 transition-all duration-300 hover:-translate-y-0.5 cursor-pointer text-base"
            >
              <span class="text-xl">💬</span>
              <span data-i18n="form_submit_btn">Испрати на WhatsApp</span>
            </button>

          </form>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // Form interactions & Live WhatsApp generator
  let count = 2;
  const peopleCountEl = document.getElementById("peopleCount");
  const nameInput = document.getElementById("userName") as HTMLInputElement;
  const msgInput = document.getElementById("userMsg") as HTMLTextAreaElement;
  const bookDateInput = document.getElementById("bookDate") as HTMLInputElement;
  const previewEl = document.getElementById("liveMsgPreview");
  const formEl = document.getElementById("inquiryForm");

  const today = new Date().toISOString().split("T")[0];
  if (bookDateInput) {
    bookDateInput.value = today;
    bookDateInput.min = today;
  }

  function getSelectedTopic(): string {
    const checked = document.querySelector('input[name="topic"]:checked') as HTMLInputElement;
    return checked ? checked.value : "Ski equipment";
  }

  function composeWhatsAppMessage(): string {
    const currentLang = document.documentElement.lang === "en" ? "en" : "mk";
    const name = nameInput?.value?.trim() || (currentLang === "mk" ? "[Вашето Име]" : "[Your Name]");
    const topic = getSelectedTopic();
    const date = bookDateInput?.value || today;
    const people = count;
    const details = msgInput?.value?.trim() || "";

    if (currentLang === "mk") {
      let topicText = topic;
      if (topic === "Ski equipment") topicText = "Ски опрема";
      else if (topic === "Snowboard equipment") topicText = "Сноуборд опрема";
      else if (topic === "Sledges and kids' gear") topicText = "Санки и детска опрема";
      else if (topic === "Mountain villa") topicText = "Планинска вила на Пониква";

      return `Здраво Ски Надја, јас сум ${name}.\nЗаинтересиран/а сум за: ${topicText}.\n• Датум: ${date}\n• Број на лица: ${people}` +
        (details ? `\n• Големини/Забелешка: ${details}` : "");
    } else {
      return `Hello Ski Nadja, I'm ${name}.\nI'm interested in: ${topic}.\n• Date: ${date}\n• Number of people: ${people}` +
        (details ? `\n• Sizing/Notes: ${details}` : "");
    }
  }

  function updateLivePreview() {
    if (previewEl) {
      previewEl.textContent = composeWhatsAppMessage();
    }
  }

  document.getElementById("btnMinus")?.addEventListener("click", () => {
    if (count > 1) {
      count--;
      if (peopleCountEl) peopleCountEl.textContent = String(count);
      updateLivePreview();
    }
  });

  document.getElementById("btnPlus")?.addEventListener("click", () => {
    if (count < 25) {
      count++;
      if (peopleCountEl) peopleCountEl.textContent = String(count);
      updateLivePreview();
    }
  });

  [nameInput, msgInput, bookDateInput].forEach(el => {
    el?.addEventListener("input", updateLivePreview);
  });

  document.querySelectorAll('input[name="topic"]').forEach(radio => {
    radio.addEventListener("change", updateLivePreview);
  });

  // Package select buttons across page
  document.querySelectorAll(".select-gear-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const gear = btn.getAttribute("data-gear");
      if (gear) {
        const radio = document.querySelector(`input[name="topic"][value="${gear}"]`) as HTMLInputElement;
        if (radio) {
          radio.checked = true;
          updateLivePreview();
        }
      }
    });
  });

  // Handle WhatsApp submit
  formEl?.addEventListener("submit", (e) => {
    e.preventDefault();
    const phone = "38970000000";
    const text = encodeURIComponent(composeWhatsAppMessage());
    window.open(`https://wa.me/${phone}?text=${text}`, "_blank");
  });

  // Initial preview render
  updateLivePreview();

  // Export update function to window for language change events
  (window as any).updateBookingPreview = updateLivePreview;
</script>
