---
// BookingConcierge.astro - Identical Interactive Booking Concierge
---
<section class="booking-section" id="contact">
  <div class="booking-container">
    <div class="booking-box">

      <!-- Left Column: Fast Contacts & Info -->
      <div class="booking-info">
        <h2 data-i18n="book_box_title">Резервирајте Ја Вашата Опрема</h2>
        <p data-i18n="book_box_desc">
          Изберете ја потребната опрема, внесете ги вашите информации и испратете директна порака на WhatsApp или
          Viber за инстант потврда на вашите големини.
        </p>

        <div class="direct-contacts">
          <a href="tel:+38970000000" class="contact-action-btn btn-phone" id="call-main">
            <span>📞 <span data-i18n="btn_direct_call">Јавете се Веднаш</span></span>
            <strong>+389 70 000 000</strong>
          </a>

          <a href="https://wa.me/38970000000" target="_blank" rel="noopener" class="contact-action-btn btn-wa"
            id="wa-main">
            <span>💬 <span data-i18n="btn_direct_wa">Пишете ни на WhatsApp</span></span>
            <strong>WhatsApp Chat →</strong>
          </a>

          <a href="viber://chat?number=%2B38970000000" class="contact-action-btn btn-viber" id="viber-main">
            <span>🟣 <span data-i18n="btn_direct_viber">Пишете ни на Viber</span></span>
            <strong>Viber Chat →</strong>
          </a>
        </div>

        <div class="location-card-mini">
          <strong data-i18n="loc_mini_t">📍 Локација на ски ренталот:</strong>
          <span data-i18n="loc_mini_d">Пониква, Осоговски Планини (веднаш на почетокот на скијачката патека).
            Работиме секој ден од 08:30 до 17:00 часот.</span>
        </div>
      </div>

      <!-- Right Column: Interactive WhatsApp Inquiry Form -->
      <form class="booking-form" id="inquiryForm">
        <div class="form-group">
          <label for="userName" data-i18n="form_name">Вашето Име и Презиме</label>
          <input type="text" id="userName" name="name" class="form-control" placeholder="пр. Марко Петровски"
            required autocomplete="name">
        </div>

        <div class="form-group">
          <label data-i18n="form_category">Што ви е потребно?</label>
          <div class="category-pills">
            <label class="category-pill-label">
              <input type="radio" name="topic" value="Ski equipment" checked>
              <span class="pill-content">
                <span>🎿</span> <span data-i18n="opt_ski">Ски Комплет</span>
              </span>
            </label>
            <label class="category-pill-label">
              <input type="radio" name="topic" value="Snowboard equipment">
              <span class="pill-content">
                <span>🏂</span> <span data-i18n="opt_board">Сноуборд</span>
              </span>
            </label>
            <label class="category-pill-label">
              <input type="radio" name="topic" value="Sledges and kids' gear">
              <span class="pill-content">
                <span>🛷</span> <span data-i18n="opt_kids">Санки / Деца</span>
              </span>
            </label>
            <label class="category-pill-label">
              <input type="radio" name="topic" value="Mountain villa">
              <span class="pill-content">
                <span>🏡</span> <span data-i18n="opt_villa">Планинска Вила</span>
              </span>
            </label>
          </div>
        </div>

        <!-- Date & People Counter -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label for="bookDate" data-i18n="form_date">Датум на пристигнување</label>
            <input type="date" id="bookDate" class="form-control">
          </div>

          <div class="form-group">
            <label data-i18n="form_people">Број на лица</label>
            <div class="counter-group">
              <button type="button" class="counter-btn" id="btnMinus">-</button>
              <span class="counter-value" id="peopleCount">2</span>
              <button type="button" class="counter-btn" id="btnPlus">+</button>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="userMsg" data-i18n="form_details">Големини / Чизми / Детали</label>
          <textarea id="userMsg" class="form-control" rows="3"
            placeholder="пр. Број на чевли 42 и 38, висина 180cm, за 2 дена"></textarea>
        </div>

        <!-- Live Message Preview -->
        <div class="preview-box">
          <strong data-i18n="msg_preview_title">📋 Преглед на пораката за WhatsApp:</strong>
          <div class="preview-text" id="liveMsgPreview">...</div>
        </div>

        <button type="submit" class="btn-submit-booking">
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2" />
          </svg>
          <span data-i18n="form_submit_btn">Испрати на WhatsApp</span>
        </button>
      </form>

    </div>
  </div>
</section>

<script>
  let count = 2;
  const peopleCountEl = document.getElementById("peopleCount") as HTMLElement;
  const nameInput = document.getElementById("userName") as HTMLInputElement;
  const msgInput = document.getElementById("userMsg") as HTMLTextAreaElement;
  const previewEl = document.getElementById("liveMsgPreview") as HTMLElement;
  const bookDateInput = document.getElementById("bookDate") as HTMLInputElement;

  const today = new Date().toISOString().split('T')[0];
  if (bookDateInput) {
    bookDateInput.value = today;
    bookDateInput.min = today;
  }

  document.getElementById("btnMinus")?.addEventListener("click", () => {
    if (count > 1) { count--; peopleCountEl.textContent = String(count); updateLivePreview(); }
  });
  document.getElementById("btnPlus")?.addEventListener("click", () => {
    if (count < 25) { count++; peopleCountEl.textContent = String(count); updateLivePreview(); }
  });

  document.querySelectorAll(".select-gear-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const gear = btn.getAttribute("data-gear");
      if (gear) {
        const radio = document.querySelector(`input[name="topic"][value="${gear}"]`) as HTMLInputElement;
        if (radio) radio.checked = true;
        updateLivePreview();
      }
    });
  });

  function getSelectedTopic() {
    const checked = document.querySelector('input[name="topic"]:checked') as HTMLInputElement;
    return checked ? checked.value : "Ski equipment";
  }

  function composeWhatsAppMessage() {
    const currentLang = document.documentElement.lang === 'en' ? 'en' : 'mk';
    const name = nameInput?.value.trim() || (currentLang === 'mk' ? "[Вашето Име]" : "[Your Name]");
    const topic = getSelectedTopic();
    const date = bookDateInput?.value || today;
    const people = count;
    const details = msgInput?.value.trim() || "";

    if (currentLang === 'mk') {
      let topicText = topic;
      if (topic === "Ski equipment") topicText = "Ски опрема";
      else if (topic === "Snowboard equipment") topicText = "Сноуборд опрема";
      else if (topic === "Sledges and kids' gear") topicText = "Санки и детска опрема";
      else if (topic === "Mountain villa") topicText = "Планинска вила на Пониква";

      return `Здраво Ски Надја, јас сум ${name}.\nЗаинтересиран/а сум за: ${topicText}.\n• Датум: ${date}\n• Број на лица: ${people}` +
        (details ? `\n• Големини/Забелешка: ${details}` : "");
    } else {
      return `Hello Ski Nadja, I'm ${name}.\nI'm interested in: ${topic}.\n• Date: ${date}\n• Number of people: ${people}` +
        (details ? `\n• Sizing/Notes: ${details}` : "");
    }
  }

  function updateLivePreview() {
    if (previewEl) {
      previewEl.textContent = composeWhatsAppMessage();
    }
  }

  nameInput?.addEventListener("input", updateLivePreview);
  msgInput?.addEventListener("input", updateLivePreview);
  bookDateInput?.addEventListener("change", updateLivePreview);
  document.querySelectorAll('input[name="topic"]').forEach(r => r.addEventListener("change", updateLivePreview));
  updateLivePreview();

  document.getElementById("inquiryForm")?.addEventListener("submit", function (e) {
    e.preventDefault();
    const PHONE = "38970000000";
    const text = composeWhatsAppMessage();
    window.open("https://wa.me/" + PHONE + "?text=" + encodeURIComponent(text), "_blank", "noopener");
  });

  (window as any).updateBookingPreview = updateLivePreview;
</script>
