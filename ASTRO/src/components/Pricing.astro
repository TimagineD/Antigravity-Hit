---
// Pricing.astro - Transparent Daily Equipment Rental Packages
---
<section class="py-24 sm:py-32 relative z-20" id="pricing">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="inline-block px-4 py-1.5 rounded-full bg-sky-100 text-sky-700 text-xs sm:text-sm font-bold tracking-wider uppercase mb-3" data-i18n="pricing_eyebrow">
        Ценовник
      </span>
      <h2 class="font-display font-black text-3xl sm:text-5xl text-slate-900 tracking-tight" data-i18n="pricing_title">
        Флексибилни Пакети за Секого
      </h2>
    </div>

    <!-- Pricing 3-Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">

      <!-- Card 1: Featured Ski Set -->
      <div class="relative bg-white rounded-3xl p-8 sm:p-10 shadow-2xl border-2 border-sky-500/80 flex flex-col justify-between transform md:-translate-y-3 transition-transform duration-300">
        <!-- Popular Badge -->
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-sky-600 to-cyan-500 text-white font-bold text-xs uppercase tracking-wider px-4 py-1.5 rounded-full shadow-md" data-i18n="badge_popular">
          Најбарано
        </div>

        <div>
          <h3 class="font-display font-black text-2xl text-slate-900 mb-1" data-i18n="price_ski_t">Комплет Скии</h3>
          <p class="text-slate-500 text-sm mb-6" data-i18n="price_ski_sub">Скии + Панцири + Стапчиња + Шлем</p>

          <!-- Rate Amount -->
          <div class="flex items-baseline gap-1 text-slate-900 mb-8 pb-6 border-b border-slate-100">
            <span class="text-sm font-medium text-slate-500" data-i18n="price_from">од</span>
            <span class="font-display font-black text-4xl sm:text-5xl tracking-tight text-sky-600">500</span>
            <span class="font-bold text-slate-700">МКД</span>
            <span class="text-sm font-medium text-slate-500 ml-1" data-i18n="price_per_day">/ ден</span>
          </div>

          <!-- Feature Bullets -->
          <ul class="space-y-4 mb-8 text-sm text-slate-600">
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_ski_f1">Carving скии за сите возрасти</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_ski_f2">Греени панцири со прилагодување</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_ski_f3">Безбедносен шлем и стапчиња</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_ski_f4">Попуст за повеќедневни наеми</span>
            </li>
          </ul>
        </div>

        <a href="#contact" class="select-gear-btn w-full inline-flex items-center justify-center bg-sky-600 hover:bg-sky-700 text-white font-bold py-4 rounded-2xl shadow-lg shadow-sky-600/30 hover:shadow-sky-600/50 transition-all duration-300 hover:-translate-y-0.5" data-gear="Ski equipment" data-i18n="btn_choose_package">
          Избери Пакет
        </a>
      </div>

      <!-- Card 2: Snowboard Set -->
      <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-200/80 flex flex-col justify-between hover:border-slate-300 transition-all duration-300 hover:-translate-y-1">
        <div>
          <h3 class="font-display font-black text-2xl text-slate-900 mb-1" data-i18n="price_board_t">Сноуборд Комплет</h3>
          <p class="text-slate-500 text-sm mb-6" data-i18n="price_board_sub">Даска + Меки Чизми + Шлем</p>

          <!-- Rate Amount -->
          <div class="flex items-baseline gap-1 text-slate-900 mb-8 pb-6 border-b border-slate-100">
            <span class="text-sm font-medium text-slate-500" data-i18n="price_from">од</span>
            <span class="font-display font-black text-4xl sm:text-5xl tracking-tight text-slate-900">600</span>
            <span class="font-bold text-slate-700">МКД</span>
            <span class="text-sm font-medium text-slate-500 ml-1" data-i18n="price_per_day">/ ден</span>
          </div>

          <!-- Feature Bullets -->
          <ul class="space-y-4 mb-8 text-sm text-slate-600">
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_board_f1">All-Mountain и Freeride даски</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_board_f2">Удобни чизми со брзо затегнување</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_board_f3">Нагодување на позиција (Goofy/Regular)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_board_f4">Вклучен шлем и заштита</span>
            </li>
          </ul>
        </div>

        <a href="#contact" class="select-gear-btn w-full inline-flex items-center justify-center bg-slate-900 hover:bg-slate-800 text-white font-bold py-4 rounded-2xl shadow-md transition-all duration-300 hover:-translate-y-0.5" data-gear="Snowboard equipment" data-i18n="btn_choose_package">
          Избери Пакет
        </a>
      </div>

      <!-- Card 3: Sledges & Kids -->
      <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-xl border border-slate-200/80 flex flex-col justify-between hover:border-slate-300 transition-all duration-300 hover:-translate-y-1">
        <div>
          <h3 class="font-display font-black text-2xl text-slate-900 mb-1" data-i18n="price_kids_t">Санки & Детска Опрема</h3>
          <p class="text-slate-500 text-sm mb-6" data-i18n="price_kids_sub">За највеселите моменти на снегот</p>

          <!-- Rate Amount -->
          <div class="flex items-baseline gap-1 text-slate-900 mb-8 pb-6 border-b border-slate-100">
            <span class="text-sm font-medium text-slate-500" data-i18n="price_from">од</span>
            <span class="font-display font-black text-4xl sm:text-5xl tracking-tight text-slate-900">300</span>
            <span class="font-bold text-slate-700">МКД</span>
            <span class="text-sm font-medium text-slate-500 ml-1" data-i18n="price_per_day">/ ден</span>
          </div>

          <!-- Feature Bullets -->
          <ul class="space-y-4 mb-8 text-sm text-slate-600">
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_kids_f1">Здрави квалитетни санки (1 и 2 седишта)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_kids_f2">Детски ски комплети со лесни везови</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_kids_f3">Заштитни топли шлемови</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-sky-500 text-base">✓</span>
              <span data-i18n="price_kids_f4">Топла заштитна облека (скафандери)</span>
            </li>
          </ul>
        </div>

        <a href="#contact" class="select-gear-btn w-full inline-flex items-center justify-center bg-slate-900 hover:bg-slate-800 text-white font-bold py-4 rounded-2xl shadow-md transition-all duration-300 hover:-translate-y-0.5" data-gear="Sledges and kids' gear" data-i18n="btn_choose_package">
          Избери Пакет
        </a>
      </div>

    </div>

  </div>
</section>
