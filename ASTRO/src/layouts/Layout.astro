---
// Layout.astro - Main HTML Shell & Client Orchestrator
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "СКИ НАДЈА – Пониква | Изнајмување Ски & Сноуборд Опрема",
  description = "Премиум ски и сноуборд опрема на самиот старт на скијачката патека на Пониква. Скии, бордови, санки, топла опрема и планинска вила."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="mk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/section1-skier.png" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#f5f8fc] text-[#0f172a] antialiased selection:bg-sky-500 selection:text-white">
    <slot />

    <!-- Global Client Script for i18n & Phone Router -->
    <script>
      import { i18nData, type Language } from "../data/i18n";

      const PHONE = "38970000000";

      function setupPhoneLinks(number: string) {
        const telHref = "tel:+" + number;
        const waHref = "https://wa.me/" + number;
        const viberHref = "viber://chat?number=%2B" + number;

        ["top-phone", "call-main", "foot-phone", "mob-call"].forEach(id => {
          const el = document.getElementById(id) as HTMLAnchorElement | null;
          if (el) el.href = telHref;
        });

        ["top-wa", "wa-main", "foot-wa", "mob-wa"].forEach(id => {
          const el = document.getElementById(id) as HTMLAnchorElement | null;
          if (el) el.href = waHref;
        });

        ["viber-main", "foot-viber"].forEach(id => {
          const el = document.getElementById(id) as HTMLAnchorElement | null;
          if (el) el.href = viberHref;
        });
      }

      let currentLang: Language = "mk";

      function applyTranslations(lang: Language) {
        currentLang = lang;
        document.documentElement.lang = lang;
        const dict = i18nData[lang];

        document.querySelectorAll("[data-i18n]").forEach(el => {
          const key = el.getAttribute("data-i18n");
          if (key && dict[key]) {
            el.textContent = dict[key];
          }
        });

        const btnMk = document.getElementById("btn-mk");
        const btnEn = document.getElementById("btn-en");
        if (btnMk && btnEn) {
          btnMk.classList.toggle("bg-sky-600", lang === "mk");
          btnMk.classList.toggle("text-white", lang === "mk");
          btnMk.classList.toggle("text-slate-600", lang !== "mk");

          btnEn.classList.toggle("bg-sky-600", lang === "en");
          btnEn.classList.toggle("text-white", lang === "en");
          btnEn.classList.toggle("text-slate-600", lang !== "en");
        }

        // Trigger WhatsApp live preview recalculation in selected language
        if (typeof (window as any).updateBookingPreview === "function") {
          (window as any).updateBookingPreview();
        }
      }

      document.getElementById("btn-mk")?.addEventListener("click", () => applyTranslations("mk"));
      document.getElementById("btn-en")?.addEventListener("click", () => applyTranslations("en"));

      setupPhoneLinks(PHONE);
    </script>
  </body>
</html>
